<Window x:Class="McInstall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="McInstall · MC 版本安装器" Icon="app.ico"
        Height="880" Width="1280" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ImageBrush x:Key="NoiseBrush" ImageSource="noise.png" TileMode="Tile"
                    Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />

        <!-- ========== 细滚动条 ========== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseBtn" Command="ScrollBar.PageUpCommand"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="7" Margin="1,3">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ScrollThumb}" CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseBtn" Command="ScrollBar.PageDownCommand"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="9" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreaseBtn" Property="Command"
                                        Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreaseBtn" Property="Command"
                                        Value="{x:Static ScrollBar.PageRightCommand}" />
                                <Setter TargetName="Thumb" Property="Width" Value="Auto" />
                                <Setter TargetName="Thumb" Property="Height" Value="7" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 按钮 ========== -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5B8CFF" Offset="0" />
                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#4F7BFF" Opacity="0.35" BlurRadius="18"
                                                  ShadowDepth="4" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6E9BFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1.025"
                                                             Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1.025"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1"
                                                             Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E7BE8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource PrimaryDisabledBg}" />
                                <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource GhostHoverBg}" />
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource GhostHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource GhostPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Line}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="RailLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource GhostPressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource LogMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource LogBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource LogText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="{DynamicResource DangerSoft}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource DangerHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 步骤轨 ========== -->
        <Style x:Key="StepRail" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" CornerRadius="8" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="1,0,1,8" Margin="0,0,20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="9,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 加载器卡片 ========== -->
        <Style x:Key="LoaderTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="14" Padding="18,16">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="Tick" Width="20" Height="20" CornerRadius="10"
                                        Background="{DynamicResource Accent}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Visibility="Collapsed"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="TickScale" ScaleX="0.4" ScaleY="0.4" />
                                    </Border.RenderTransform>
                                    <TextBlock Text="✓" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TickScale"
                                                             Storyboard.TargetProperty="ScaleX" To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TickScale"
                                                             Storyboard.TargetProperty="ScaleY" To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SurfaceHover}" />
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 开关 ========== -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="38" Height="21" CornerRadius="11"
                                    Background="{DynamicResource SwitchTrack}" VerticalAlignment="Center">
                                <Border x:Name="Knob" Width="15" Height="15" CornerRadius="8"
                                        Background="{DynamicResource Knob}" HorizontalAlignment="Left"
                                        Margin="3,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentGradient}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="17"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="0"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 输入 ========== -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Bottom"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 下拉框 ========== -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource InputBg}"
                                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                                                CornerRadius="9" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource BorderStrong}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="13,0,36,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   VerticalOffset="5" StaysOpen="False">
                                <Border Background="{DynamicResource Surface2}"
                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                        CornerRadius="11" Padding="4" MinWidth="220" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="22"
                                                          ShadowDepth="6" Direction="270" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 滑块 ========== -->
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="22" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="2" Background="{DynamicResource Track}"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="2"
                                                        Background="{DynamicResource AccentGradient}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource Knob}" />
                                                    <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.5" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 进度条 ========== -->
        <Style x:Key="DarkProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{DynamicResource Track}" CornerRadius="3" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                    ClipToBounds="True">
                                <Grid>
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#5B8CFF" Offset="0" />
                                                <GradientStop Color="#8B5CF6" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="Sheen" Width="120" HorizontalAlignment="Left" Opacity="0.45">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#B3FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SheenShift" X="-140" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 文字层级 ========== -->
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MicroLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <Style x:Key="RailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Rectangle Fill="{StaticResource NoiseBrush}" Opacity="0.35" IsHitTestVisible="False" />
            <Ellipse Width="780" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-260,-300,0,0" Opacity="0.45" Fill="{DynamicResource AmbientGlow1}"
                     IsHitTestVisible="False" />
            <Ellipse Width="820" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-300,-320" Opacity="0.35" Fill="{DynamicResource AmbientGlow2}"
                     IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ========== 自绘标题栏 ========== -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Grid Width="26" Height="26">
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5B8CFF" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Path Data="M13 5 L21 9 L21 17 L13 21 L5 17 L5 9 Z M13 5 L13 13 M5 9 L13 14 L21 9"
                                  Stroke="White" StrokeThickness="1.1" StrokeLineJoin="Round" Fill="Transparent" />
                        </Grid>
                        <TextBlock Text="McInstall" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Background="{DynamicResource Line}" Margin="12,0" />
                        <TextBlock Text="MC 版本安装器" FontSize="10.5" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="Step1Button" Style="{StaticResource StepRail}" Tag="1"
                                Click="StepBar_Click" ToolTip="回到第一步">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step1Dot" Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource AccentGradient}" BorderThickness="1"
                                        BorderBrush="Transparent" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step1Num" Text="1" Foreground="White" FontSize="10"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Step1Label" Text="选版本" Margin="7,0,0,0" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="StepLine1" Width="38" Height="1" Background="{DynamicResource AccentGradient}"
                                Margin="8,0" VerticalAlignment="Center" />
                        <Button x:Name="Step2Button" Style="{StaticResource StepRail}" Tag="2"
                                Click="StepBar_Click" ToolTip="回到第二步">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step2Dot" Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource StepDotIdle}"
                                        BorderBrush="{DynamicResource StepDotBorder}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Step2Num" Text="2" Foreground="{DynamicResource Faint}"
                                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Step2Label" Text="加载器" Margin="7,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="StepLine2" Width="38" Height="1" Background="{DynamicResource StepLine}"
                                Margin="8,0" VerticalAlignment="Center" />
                        <Button x:Name="Step3Button" Style="{StaticResource StepRail}" Tag="3"
                                Click="StepBar_Click" ToolTip="回到第三步">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step3Dot" Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource StepDotIdle}"
                                        BorderBrush="{DynamicResource StepDotBorder}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Step3Num" Text="3" Foreground="{DynamicResource Faint}"
                                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Step3Label" Text="环境" Margin="7,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="StepLine3" Width="38" Height="1" Background="{DynamicResource StepLine}"
                                Margin="8,0" VerticalAlignment="Center" />
                        <Button x:Name="Step4Button" Style="{StaticResource StepRail}" Tag="4"
                                Click="StepBar_Click" ToolTip="回到第四步">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step4Dot" Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource StepDotIdle}"
                                        BorderBrush="{DynamicResource StepDotBorder}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Step4Num" Text="4" Foreground="{DynamicResource Faint}"
                                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Step4Label" Text="命名" Margin="7,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="StepLine4" Width="38" Height="1" Background="{DynamicResource StepLine}"
                                Margin="8,0" VerticalAlignment="Center" />
                        <Button x:Name="Step5Button" Style="{StaticResource StepRail}" Tag="5"
                                Click="StepBar_Click" ToolTip="回到第五步">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Step5Dot" Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource StepDotIdle}"
                                        BorderBrush="{DynamicResource StepDotBorder}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Step5Num" Text="5" Foreground="{DynamicResource Faint}"
                                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Step5Label" Text="安装" Margin="7,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <CheckBox x:Name="LogToggle" Style="{StaticResource Switch}" Content="日志"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  Checked="LogToggle_Changed" Unchecked="LogToggle_Changed" />
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Click="Minimize_Click" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                FontSize="10" ToolTip="最小化" AutomationProperties.Name="最小化" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Click="Maximize_Click" ToolTip="最大化 / 还原"
                                AutomationProperties.Name="最大化或还原">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
                                Click="Close_Click" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                FontSize="10" ToolTip="关闭" AutomationProperties.Name="关闭" />
                    </StackPanel>

                    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource Line}" IsHitTestVisible="False" />
                </Grid>

                <!-- ========== 主体 ========== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="296" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧常驻配置栏 -->
                    <Border x:Name="Rail" Grid.Column="0" Background="{DynamicResource Surface2}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0">
                        <Grid Margin="24,26,24,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="当前配置" Style="{StaticResource MicroLabel}" />
                                <TextBlock x:Name="SelectedVersionText" Text="—" FontSize="30"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                           Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="KindText" Text="—" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource Faint}"
                                               Margin="5,0" />
                                    <TextBlock x:Name="JavaText" Text="Java —" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="StateText" Text="—" FontSize="10.5" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                                 Value="已安装">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource SuccessText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                                 Value="文件缺失">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource DangerText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="加载器" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="RailLoaderText" Grid.Column="1" Text="—"
                                               Style="{StaticResource RailValue}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="版本名" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="RailNameText" Grid.Column="1" Text="—"
                                               Style="{StaticResource RailValue}"
                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="位置" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="GameDirText" Grid.Column="1" Text="正在探测…"
                                               FontSize="10.5" Foreground="{DynamicResource Muted}"
                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                                <TextBlock x:Name="PclStatusText" FontSize="10"
                                           Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"
                                           Margin="64,0,0,0" />
                            </StackPanel>

                            <Border x:Name="InstalledBox" Grid.Row="1" Visibility="Collapsed" Margin="0,16,0,0"
                                    Background="{DynamicResource SuccessSoft}"
                                    BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1"
                                    CornerRadius="11" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="5" Height="5" CornerRadius="3"
                                                Background="{DynamicResource Success}" VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="已安装版本" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{DynamicResource SuccessText}" />
                                    </StackPanel>
                                    <TextBlock Text="可以直接启动；缺文件就在这里补齐。" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <Button x:Name="RepairButton" Style="{StaticResource PrimaryButton}"
                                            Content="校验 / 修复" Height="34" Padding="14,0" Margin="0,10,0,0"
                                            Click="Repair_Click" />
                                    <StackPanel x:Name="RepairPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock x:Name="RepairPhaseText" Foreground="{DynamicResource Ink}"
                                                   FontWeight="SemiBold" FontSize="11.5" />
                                        <ProgressBar x:Name="RepairProgressBar" Style="{StaticResource DarkProgress}"
                                                     Height="5" Margin="0,7,0,0" Minimum="0" Maximum="1"
                                                     Value="0" />
                                        <TextBlock x:Name="RepairDetailText" Foreground="{DynamicResource Muted}"
                                                   FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RepairResultText" Visibility="Collapsed"
                                                   Foreground="{DynamicResource InkSoft}" FontSize="10.5"
                                                   Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="17" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Path Grid.Row="2" Data="M68 18 L118 46 L118 104 L68 132 L18 104 L18 46 Z M68 18 L68 75 M18 46 L68 75 L118 46"
                                  Stroke="{DynamicResource CubeWatermark}" StrokeThickness="1.2"
                                  Fill="Transparent" Opacity="0.55" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,20,0,10" />

                            <StackPanel Grid.Row="3">
                                <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12" />
                                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,2">
                                    <Button x:Name="LocatePclButton" Content="定位 PCL"
                                            Style="{StaticResource RailLinkButton}" Margin="0,0,4,2"
                                            Click="LocatePcl_Click" />
                                    <Button x:Name="OpenFolderButton" Content="打开目录"
                                            Style="{StaticResource RailLinkButton}" Margin="0,0,0,2"
                                            Click="OpenFolder_Click" />
                                    <Button x:Name="ChangeDirButton" Content="更改目录"
                                            Style="{StaticResource RailLinkButton}" Margin="0,0,4,0"
                                            Click="ChangeDir_Click" />
                                    <Button x:Name="SettingsButton" Content="设置"
                                            Style="{StaticResource RailLinkButton}" Click="Settings_Click" />
                                </UniformGrid>
                                <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,10" />
                                <TextBlock Text="外观" Style="{StaticResource MicroLabel}" Margin="0,0,0,6" />
                                <Border Background="{DynamicResource Surface3}" CornerRadius="9" Padding="3">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="ThemeSystemOption" Style="{StaticResource MiniSegment}"
                                                     Content="跟随" GroupName="RailTheme"
                                                     Checked="ThemeOption_Checked" />
                                        <RadioButton x:Name="ThemeLightOption" Style="{StaticResource MiniSegment}"
                                                     Content="浅色" GroupName="RailTheme"
                                                     Checked="ThemeOption_Checked" />
                                        <RadioButton x:Name="ThemeDarkOption" Style="{StaticResource MiniSegment}"
                                                     Content="深色" GroupName="RailTheme"
                                                     Checked="ThemeOption_Checked" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock x:Name="AppVersionText" Text="v0.5.0" FontSize="9.5"
                                           Foreground="{DynamicResource Faint}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧内容 -->
                    <Grid x:Name="ContentArea" Grid.Column="1"
                          Background="{DynamicResource Surface}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="LogRow" Height="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 第一步 -->
                        <Grid x:Name="Step1Panel" Grid.Row="0" Margin="40,30,40,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="01 · 选择版本" Style="{StaticResource Kicker}" />
                                <TextBlock Text="选择一个 Minecraft 版本" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="正式版、快照，或从已安装版本里做校验 / 修复。"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabRelease" Style="{StaticResource TextTab}"
                                                 Content="正式版" IsChecked="True" Checked="Filter_Changed" />
                                    <RadioButton x:Name="TabSnapshot" Style="{StaticResource TextTab}"
                                                 Content="快照" Checked="Filter_Changed" />
                                    <RadioButton x:Name="TabInstalled" Style="{StaticResource TextTab}"
                                                 Content="已安装" Checked="Filter_Changed" />
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center" MaxWidth="360"
                                      HorizontalAlignment="Left">
                                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                                             Padding="32,0,12,0" ToolTip="按版本号搜索（Ctrl+F）"
                                             AutomationProperties.Name="搜索版本"
                                             TextChanged="Search_TextChanged" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Faint}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="搜索版本号" FontSize="11.5" Foreground="{DynamicResource Placeholder}"
                                               Margin="32,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="CountText" Grid.Column="2" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Faint}" FontSize="11" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Margin="16,0,16,6" Padding="0,0,0,6"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="版本号" Style="{StaticResource MicroLabel}" />
                                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource MicroLabel}" />
                                        <TextBlock Grid.Column="2" Text="发布时间" Style="{StaticResource MicroLabel}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="VersionList" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="VersionList_SelectionChanged"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="92" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Id}" FontSize="13"
                                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource Ink}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Border x:Name="BadgeBox" Grid.Column="1" Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderStrong}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock x:Name="BadgeText" Text="{Binding Badge}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource Muted}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Subtitle}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Faint}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="snapshot">
                                                        <Setter TargetName="BadgeText" Property="Foreground"
                                                                Value="{DynamicResource Warning}" />
                                                        <Setter TargetName="BadgeBox" Property="BorderBrush"
                                                                Value="{DynamicResource WarningBorder}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="installed">
                                                        <Setter TargetName="BadgeText" Property="Foreground"
                                                                Value="{DynamicResource SuccessText}" />
                                                        <Setter TargetName="BadgeBox" Property="BorderBrush"
                                                                Value="{DynamicResource SuccessBorder}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Row" Background="Transparent"
                                                                    CornerRadius="8" Margin="0,1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="AccentBar" Width="2"
                                                                            CornerRadius="1"
                                                                            Background="{DynamicResource Accent}"
                                                                            Margin="0,9"
                                                                            RenderTransformOrigin="0.5,0.5">
                                                                        <Border.RenderTransform>
                                                                            <ScaleTransform x:Name="AccentScale"
                                                                                            ScaleX="1" ScaleY="0" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                    <Border Grid.Column="1" Padding="14,9">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Row" Property="Background"
                                                                            Value="{DynamicResource ListSelected}" />
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="AccentScale"
                                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                                 To="1" Duration="0:0:0.18">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut" />
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="AccentScale"
                                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                                 To="0" Duration="0:0:0.14" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True" />
                                                                        <Condition Property="IsSelected" Value="False" />
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Row" Property="Background"
                                                                            Value="{DynamicResource ListHover}" />
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   Foreground="{DynamicResource Faint}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="EmptyText" Text="没有匹配的版本" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        <Button x:Name="RetryButton" Content="重新获取" Visibility="Collapsed"
                                                Style="{StaticResource GhostButton}" Height="30"
                                                Padding="14,0" FontSize="11" Margin="0,12,0,0"
                                                HorizontalAlignment="Center" Click="RetryVersions_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                                                Margin="16,8,16,0" VerticalAlignment="Top"
                                                AutomationProperties.Name="正在获取版本清单">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0.75" />
                                                <Style.Triggers>
                                                    <Trigger Property="Visibility" Value="Visible">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard AutoReverse="True"
                                                                            RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="0:0:0.9" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                            <TextBlock Text="正在获取版本清单…" FontSize="11"
                                                       Foreground="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="MOJANG MANIFEST" FontSize="9"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{DynamicResource Faint}"
                                                       Margin="12,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Grid Height="34" Margin="0,0,0,2">
                                            <Border Width="190" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Border Width="54" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" Margin="0,0,104,0"
                                                    VerticalAlignment="Center" />
                                            <Border Width="70" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="34" Margin="0,0,0,2">
                                            <Border Width="150" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Border Width="54" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" Margin="0,0,104,0"
                                                    VerticalAlignment="Center" />
                                            <Border Width="70" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="34" Margin="0,0,0,2">
                                            <Border Width="210" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Border Width="54" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" Margin="0,0,104,0"
                                                    VerticalAlignment="Center" />
                                            <Border Width="70" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="34" Margin="0,0,0,2">
                                            <Border Width="166" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Border Width="54" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" Margin="0,0,104,0"
                                                    VerticalAlignment="Center" />
                                            <Border Width="70" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="34" Margin="0,0,0,2">
                                            <Border Width="178" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Border Width="54" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" Margin="0,0,104,0"
                                                    VerticalAlignment="Center" />
                                            <Border Width="70" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="34">
                                            <Border Width="140" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Border Width="54" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" Margin="0,0,104,0"
                                                    VerticalAlignment="Center" />
                                            <Border Width="70" Height="9" CornerRadius="4"
                                                    Background="{DynamicResource Surface3}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Faint}" FontSize="10.5"
                                       Text="文件会写入 PCL 的游戏目录。装完回 PCL 刷新版本列表即可启动；如果没显示，重启 PCL。" />
                        </Grid>

                        <!-- 第二步 -->
                        <Grid x:Name="Step2Panel" Grid.Row="0" Margin="40,30,40,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="02 · 加载器" Style="{StaticResource Kicker}" />
                                <TextBlock Text="选择加载器与插件" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="原版只需要官方文件；Fabric / Forge / NeoForge 会额外写入依赖库。"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,24,0,0">
                                <RadioButton x:Name="LoaderVanilla" Style="{StaticResource LoaderTile}" Tag="vanilla"
                                             GroupName="LoaderGroup" IsChecked="True" Checked="Loader_Checked"
                                             Margin="0,0,10,10" AutomationProperties.Name="原版">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource Surface3}" VerticalAlignment="Top">
                                            <Path Data="M12 2 L22 8 L22 16 L12 22 L2 16 L2 8 Z M12 2 L12 12 M2 8 L12 14 L22 8"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="原版" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="官方正式版 / 快照" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="LoaderFabric" Style="{StaticResource LoaderTile}" Tag="fabric"
                                             GroupName="LoaderGroup" Checked="Loader_Checked" Margin="0,0,0,10"
                                             AutomationProperties.Name="Fabric">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource Surface3}" VerticalAlignment="Top">
                                            <Path Data="M13 2 L4 14 H11 L9 22 L20 10 H13 Z"
                                                  Fill="{DynamicResource Accent}" Width="22" Height="22"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Fabric" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="轻量、更新快" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="LoaderForge" Style="{StaticResource LoaderTile}" Tag="forge"
                                             GroupName="LoaderGroup" Checked="Loader_Checked"
                                             Margin="0,0,10,0" AutomationProperties.Name="Forge">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource Surface3}" VerticalAlignment="Top">
                                            <Path Data="M3 8 H18 L16 12 H6 Z M8 12 V16 H5 V19 H19 V16 H16 V12"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Forge" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="模组生态最全" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="LoaderNeoForge" Style="{StaticResource LoaderTile}" Tag="neoforge"
                                             GroupName="LoaderGroup" Checked="Loader_Checked"
                                             AutomationProperties.Name="NeoForge">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource Surface3}" VerticalAlignment="Top">
                                            <Path Data="M12 3 L22 8 L12 13 L2 8 Z M2 12 L12 17 L22 12 M2 16 L12 21 L22 16"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="NeoForge" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="1.20.2+ 的新分支" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
                            </UniformGrid>

                            <Grid Grid.Row="2" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="加载器版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="不确定就保持自动" FontSize="10"
                                               Foreground="{DynamicResource Faint}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="LoaderVersionBox" Grid.Column="1"
                                          Style="{StaticResource DarkCombo}"
                                          SelectionChanged="LoaderVersion_Changed" />
                                <TextBlock x:Name="LoaderVersionHint" Grid.Column="2" Margin="16,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                    Margin="0,20,0,0" Padding="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="OptiFineCheck" Style="{StaticResource Switch}"
                                              Checked="OptiFine_Checked" Unchecked="OptiFine_Unchecked"
                                              IsEnabled="False">
                                        <StackPanel>
                                            <TextBlock Text="同时安装 OptiFine" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="作为 Forge 附加项放进 mods/，不改 client.jar"
                                                       FontSize="10.5" Foreground="{DynamicResource Muted}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <ComboBox x:Name="OptiFineVersionBox" Grid.Column="1"
                                              Style="{StaticResource DarkCombo}" IsEnabled="False" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="4" VerticalAlignment="Bottom" Margin="0,16,0,0"
                                       FontSize="10.5" Foreground="{DynamicResource Faint}"
                                       TextWrapping="Wrap"
                                       Text="Forge / NeoForge 需要 Java，找不到时自动下载 JRE。OptiFine 只支持「Forge + mod」这一种装法。" />
                        </Grid>

                        <!-- 第三步 -->
                        <Grid x:Name="Step3Panel" Grid.Row="0" Margin="40,30,40,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="03 · 环境" Style="{StaticResource Kicker}" />
                                <TextBlock Text="高级设置" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="都有默认值。不确定就保持原样，直接继续。"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>

                            <ScrollViewer x:Name="Step3Scroll" Grid.Row="1" Margin="0,22,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="下载线程" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="线程越高越快，也更容易被限速。" FontSize="10.5"
                                                       Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="ThreadsLabel" Text="16" FontSize="32"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="线程" FontSize="10.5"
                                                           Foreground="{DynamicResource Faint}"
                                                           Margin="7,0,0,5" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <Slider x:Name="ThreadsSlider" Grid.Row="1"
                                                    Style="{StaticResource DarkSlider}" Minimum="1"
                                                    Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="16" ValueChanged="Threads_Changed" Margin="0,8,0,0" />
                                        </Grid>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                            Padding="0,18,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="安装后全量校验" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="较慢，但会逐文件确认。默认只检查缺失文件。"
                                                           FontSize="10.5" Foreground="{DynamicResource Muted}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox x:Name="FullVerifyBox" Grid.Column="1"
                                                      Style="{StaticResource Switch}"
                                                      AutomationProperties.Name="安装后全量校验"
                                                      Content="启用"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                            Padding="0,18,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Java 运行时" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="留空 = 自动探测；需要时下载 JRE。"
                                                           FontSize="10.5" Foreground="{DynamicResource Muted}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="JavaPathBox"
                                                             Style="{StaticResource DarkTextBox}"
                                                             AutomationProperties.Name="Java 路径" />
                                                    <Button x:Name="BrowseJavaButton" Grid.Column="1"
                                                            Content="浏览…"
                                                            Style="{StaticResource GhostButton}"
                                                            Height="38" Margin="8,0,0,0"
                                                            Click="BrowseJava_Click" />
                                                </Grid>
                                                <TextBlock x:Name="JavaHintText" FontSize="10"
                                                           Foreground="{DynamicResource Faint}"
                                                           Margin="0,7,0,0" TextWrapping="Wrap"
                                                           Text="留空 = 自动探测；找不到会下载 JRE。" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                            Padding="0,18,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="安装位置" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="PCL 的游戏目录，会写入 versions / libraries / assets。"
                                                           FontSize="10.5" Foreground="{DynamicResource Muted}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="GameDirBox"
                                                             Style="{StaticResource DarkTextBox}"
                                                             AutomationProperties.Name="安装位置" />
                                                    <Button x:Name="BrowseGameDirButton" Grid.Column="1"
                                                            Content="浏览…"
                                                            Style="{StaticResource GhostButton}"
                                                            Height="38" Margin="8,0,0,0"
                                                            Click="ChangeDir_Click" />
                                                </Grid>
                                                <TextBlock x:Name="GameDirHintText" FontSize="10"
                                                           Foreground="{DynamicResource Faint}"
                                                           Margin="0,7,0,0" TextWrapping="Wrap"
                                                           Text="会复用这个目录里已下载的库和资源。" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 第四步 -->
                        <Grid x:Name="Step4Panel" Grid.Row="0" Margin="40,30,40,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="04 · 命名" Style="{StaticResource Kicker}" />
                                <TextBlock Text="给这次安装起个名字" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="这个名字会出现在 PCL 的版本列表里。"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>

                            <ScrollViewer x:Name="Step4Scroll" Grid.Row="1" Margin="0,24,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid MaxWidth="900" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                        <TextBlock Text="版本名" Style="{StaticResource FieldLabel}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NameBox" Style="{StaticResource LineTextBox}"
                                                     AutomationProperties.Name="版本名"
                                                     TextChanged="Name_TextChanged" />
                                            <Button x:Name="RenameButton" Grid.Column="1" Content="改名…"
                                                    Style="{StaticResource GhostButton}" Height="38"
                                                    Margin="16,0,0,10" Padding="16,0"
                                                    VerticalAlignment="Bottom" Click="Rename_Click" />
                                        </Grid>
                                        <TextBlock x:Name="NameHint" FontSize="10.5"
                                                   Foreground="{DynamicResource Faint}" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />

                                        <Border x:Name="NameNoteBanner" Visibility="Collapsed"
                                                Background="{DynamicResource WarningSoft}"
                                                BorderBrush="{DynamicResource WarningBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="12,9"
                                                Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Warning}"
                                                           VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <TextBlock x:Name="NameNoteText" Grid.Column="1" Margin="8,0,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource WarningText}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="这次会写入" Style="{StaticResource MicroLabel}"
                                                   Margin="0,26,0,8" />
                                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Muted}"
                                                   FontSize="10.5"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   TextWrapping="Wrap" LineHeight="24" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource Surface2}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="14" Padding="20" VerticalAlignment="Top">
                                        <Grid>
                                            <Path Data="M62 16 L108 42 L108 96 L62 122 L16 96 L16 42 Z M62 16 L62 69 M16 42 L62 69 L108 42"
                                                  Stroke="{DynamicResource CubeWatermark}" StrokeThickness="1.2"
                                                  Fill="Transparent" HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom" Opacity="0.7"
                                                  IsHitTestVisible="False" />
                                            <StackPanel>
                                                <TextBlock Text="将创建" Style="{StaticResource MicroLabel}" />
                                                <TextBlock Text="{Binding Text, ElementName=NameBox}" FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}"
                                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                                <Border Height="1" Background="{DynamicResource Line}"
                                                        Margin="0,14,0,14" />
                                                <TextBlock Text="目录" Style="{StaticResource MicroLabel}" />
                                                <TextBlock Text="{Binding Text, ElementName=GameDirText}"
                                                           FontSize="10" Foreground="{DynamicResource Muted}"
                                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- 第五步 -->
                        <Grid x:Name="Step5Panel" Grid.Row="0" Margin="40,30,40,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="05 · 安装" Style="{StaticResource Kicker}" />
                                <TextBlock Text="下载与安装" Style="{StaticResource PageTitle}" />
                                <TextBlock x:Name="TargetSummaryText" Style="{StaticResource PageSubtitle}"
                                           Text="—" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ScrollViewer x:Name="Step5Scroll" Grid.Row="1" Margin="0,22,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PercentText" Text="0%" FontSize="72"
                                                   FontWeight="Bold" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center" Margin="0,0,30,0">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#5B8CFF" Offset="0" />
                                                    <GradientStop Color="#A78BFA" Offset="1" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="下载速度" Style="{StaticResource MicroLabel}" />
                                            <TextBlock x:Name="DownloadSpeedText" Text="—" FontSize="26"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock x:Name="EtaText" Text="" FontSize="10.5"
                                                       Foreground="{DynamicResource Muted}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar x:Name="ProgressBar" Style="{StaticResource DarkProgress}"
                                                 Height="6" Margin="0,22,0,0" Minimum="0" Maximum="1"
                                                 Value="0" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="当前文件" Style="{StaticResource MicroLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="CurrentFileText" Grid.Column="1" Text="—"
                                                   FontSize="10.5" Margin="14,0,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                            Margin="0,18,0,0" Padding="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="PhaseText" Text="准备就绪" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock x:Name="DetailText"
                                                       Text="点右下角「下载」开始；安装时会实时显示下载速度与当前文件。"
                                                       Foreground="{DynamicResource Muted}" FontSize="10.5"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid x:Name="FeatureTips" Columns="3" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <Border Width="5" Height="5" CornerRadius="3"
                                                    Background="{DynamicResource Accent}"
                                                    VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <StackPanel>
                                                <TextBlock Text="断点续传" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkSoft}" />
                                                <TextBlock Text="中断后接着下" FontSize="9.5"
                                                           Foreground="{DynamicResource Faint}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                            <Border Width="5" Height="5" CornerRadius="3"
                                                    Background="{DynamicResource Accent2}"
                                                    VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <StackPanel>
                                                <TextBlock Text="SHA1 校验" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkSoft}" />
                                                <TextBlock Text="逐文件确认" FontSize="9.5"
                                                           Foreground="{DynamicResource Faint}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="5" Height="5" CornerRadius="3"
                                                    Background="{DynamicResource Success}"
                                                    VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <StackPanel>
                                                <TextBlock Text="自动复用" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkSoft}" />
                                                <TextBlock Text="已有文件不重下" FontSize="9.5"
                                                           Foreground="{DynamicResource Faint}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border x:Name="ResultBox" Visibility="Collapsed" Margin="0,18,0,0"
                                            Background="{DynamicResource SuccessSoft}"
                                            BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{DynamicResource Surface3}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Success}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SuccessText}"
                                                           FontSize="11" LineHeight="18" />
                                                <Button x:Name="OpenResultButton" Content="打开版本目录"
                                                        Style="{StaticResource GhostButton}" Height="30"
                                                        Padding="12,0" Margin="0,10,0,0"
                                                        HorizontalAlignment="Left"
                                                        Click="OpenVersionFolder_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 日志抽屉 -->
                        <Border x:Name="LogPanel" Grid.Row="1" Margin="40,12,40,0"
                                Background="{DynamicResource LogBg}"
                                BorderBrush="{DynamicResource LogBorder}" BorderThickness="1"
                                CornerRadius="11" Padding="0" Visibility="Collapsed">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource LogHeader}"
                                        CornerRadius="10,10,0,0" Padding="14,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="5" Height="5" CornerRadius="3"
                                                    Background="{DynamicResource Success}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="运行日志" Foreground="{DynamicResource LogText}"
                                                       FontSize="10.5" FontWeight="SemiBold" />
                                            <TextBlock Text="LIVE" Foreground="{DynamicResource LogMuted}"
                                                       FontSize="9" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button x:Name="CopyLogButton" Content="复制"
                                                Style="{StaticResource LogActionButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                ToolTip="复制完整日志" AutomationProperties.Name="复制日志"
                                                Click="CopyLog_Click" />
                                    </Grid>
                                </Border>
                                <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource LogText}"
                                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         FontSize="10.5" Padding="12,8"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         CaretBrush="{DynamicResource LogText}"
                                         SelectionBrush="{DynamicResource Selection}" />
                            </DockPanel>
                        </Border>

                        <!-- 底栏 -->
                        <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,1,0,0" Padding="40,12" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BackButton" Content="← 上一步"
                                        Style="{StaticResource GhostButton}" BorderThickness="0"
                                        Foreground="{DynamicResource Muted}" IsEnabled="False"
                                        Click="Back_Click" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="StatusDot" Width="5" Height="5" CornerRadius="3"
                                            Background="{DynamicResource StatusIdle}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}"
                                               FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="CancelButton" Content="取消"
                                            Style="{StaticResource DangerGhostButton}"
                                            Visibility="Collapsed" Margin="0,0,8,0"
                                            Click="Cancel_Click" />
                                    <Button x:Name="NextButton" Content="继续"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="Next_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ========== 设置 ========== -->
            <Border x:Name="SettingsOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed"
                    MouseLeftButtonDown="SettingsOverlay_MouseLeftButtonDown">
                <Border x:Name="SettingsCard" Background="{DynamicResource Surface2}"
                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                        CornerRadius="18" Width="620" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Padding="28,24">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="36" ShadowDepth="12"
                                          Direction="270" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource Kicker}" />
                        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,5,0,0" />
                        <TextBlock Text="这些值会作为新安装任务的默认选项。" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />

                        <TextBlock Text="外观" Style="{StaticResource FieldLabel}" Margin="0,20,0,7" />
                        <ComboBox x:Name="ThemeBox" Style="{StaticResource DarkCombo}">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                        <TextBlock Text="跟随系统时会随 Windows 深浅模式自动切换。" FontSize="10"
                                   Foreground="{DynamicResource Faint}" Margin="0,7,0,0" />

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                Margin="0,18,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="下载线程数" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="SettingsThreadsSlider" Grid.Column="1"
                                    Style="{StaticResource DarkSlider}" Minimum="1" Maximum="32"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="16"
                                    ValueChanged="SettingsThreads_Changed" />
                            <TextBlock x:Name="SettingsThreadsLabel" Grid.Column="2" Text="16"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox x:Name="SettingsFullVerify" Style="{StaticResource Switch}"
                                  Margin="0,16,0,0" Content="安装后默认做全量 SHA1 校验" />

                        <TextBlock Text="Java 路径" Style="{StaticResource FieldLabel}"
                                   Margin="0,20,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SettingsJavaPathBox" Style="{StaticResource DarkTextBox}" />
                            <Button Grid.Column="1" Content="浏览"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="BrowseSettingsJava_Click" />
                        </Grid>
                        <TextBlock Text="留空 = 自动探测，找不到会下载 JRE。" FontSize="10"
                                   Foreground="{DynamicResource Faint}" Margin="0,7,0,0" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="清理缓存" Style="{StaticResource GhostButton}"
                                    Click="ClearCache_Click" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="取消" Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,0" Click="CloseSettings_Click" />
                                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                        Height="36" Padding="24,0" Click="SaveSettings_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
