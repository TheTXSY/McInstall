<Window x:Class="McInstall.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名版本" Icon="app.ico" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="36" ShadowDepth="12"
                                      Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCaptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySmall" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5B8CFF" Offset="0" />
                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#4F7BFF" Opacity="0.3" BlurRadius="16"
                                                  ShadowDepth="4" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6E9BFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E7BE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostSmall" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource GhostHoverBg}" />
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{DynamicResource GhostHoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Bottom"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid Width="18" Height="18">
                        <Border CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5B8CFF" Offset="0" />
                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Path Data="M9 3.5 L14.5 6.5 L14.5 12 L9 15 L3.5 12 L3.5 6.5 Z"
                              Stroke="White" StrokeThickness="0.9" Fill="Transparent" />
                    </Grid>
                    <TextBlock Text="重命名版本" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkSoft}" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource DialogCaptionButton}"
                        Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                        Margin="0,0,8,0" Click="Close_Click" ToolTip="关闭"
                        AutomationProperties.Name="关闭" />
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource Line}" IsHitTestVisible="False" />
            </Grid>

            <Border x:Name="Card" Grid.Row="1" Style="{StaticResource DialogCard}" Margin="16,14,16,16"
                    Padding="26,24" RenderTransformOrigin="0.5,0.5">
                <StackPanel>
                    <TextBlock Text="RENAME" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="给这个版本起个名字" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" Margin="0,6,0,0" />
                    <TextBlock Text="名字不能和已有版本重复，重复时会自动加序号。" FontSize="11.5"
                               Foreground="{DynamicResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="版本名" FontSize="10.5" Foreground="{DynamicResource Muted}"
                               Margin="0,22,0,0" />
                    <TextBox x:Name="NameBox" Style="{StaticResource DialogTextBox}" Margin="0,4,0,0"
                             AutomationProperties.Name="版本名" TextChanged="NameBox_TextChanged" />
                    <TextBlock x:Name="Hint" FontSize="10" Foreground="{DynamicResource Faint}"
                               Margin="0,9,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认名会自动去重" FontSize="10" Foreground="{DynamicResource Faint}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="取消" Style="{StaticResource GhostSmall}" Margin="0,0,8,0"
                                    Click="Cancel_Click" />
                            <Button Content="确定" Style="{StaticResource PrimarySmall}"
                                    IsDefault="True" Click="Ok_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
